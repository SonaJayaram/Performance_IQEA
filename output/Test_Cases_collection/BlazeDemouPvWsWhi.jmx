<jmeterTestPlan version="1.2" properties="5.0">
  <hashTree>
    <TestPlan>
      <stringProp name="TestPlan.comments"></stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.serialize_threadgroups">false</stringProp>
      <boolProp name="TestPlan.batchlocusturte">true</boolProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup>
        <stringProp name="ThreadGroup.num_threads">2</stringProp>
        <stringProp name="ThreadGroup.ramp_time">10</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <ConfigTestElement guiclass="WebDriverConfigGui" testclass="ConfigTestElement" testname="WebDriver Config" enabled="true">
          <stringProp name="browser">firefox</stringProp>
        </ConfigTestElement>
        <hashTree/>
        <CSVDataSet>
          <stringProp name="filename">data.csv</stringProp>
          <stringProp name="fileEncoding"></stringProp>
          <stringProp name="variableNames">city,destination</stringProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <boolProp name="ignoreFirstLine">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>
        <WebDriverSampler guiclass="WebDriverSamplerGui" testclass="WebDriverSampler" testname="Open Home Page" enabled="true">
          <stringProp name="WebDriverSampler.execute">
            <![CDATA[
WDS.sampleResult.sampleStart();
try {
    WDS.browser.get("https://blazedemo.com/");
    WDS.sampleResult.setSuccessful(true);
} catch (e) {
    WDS.sampleResult.setSuccessful(false);
    throw e;
}
WDS.sampleResult.sampleEnd();
]]>
          </stringProp>
        </WebDriverSampler>
        <hashTree/>
        <WebDriverSampler guiclass="WebDriverSamplerGui" testclass="WebDriverSampler" testname="Select Departure City" enabled="true">
          <stringProp name="WebDriverSampler.execute">
            <![CDATA[
WDS.sampleResult.sampleStart();
try {
    WDS.browser.findElement(org.openqa.selenium.By.name("fromPort")).sendKeys("Paris");
    WDS.browser.findElement(org.openqa.selenium.By.name("toPort")).sendKeys("Buenos Aires");
    WDS.browser.findElement(org.openqa.selenium.By.tagName("input")).click();
    WDS.sampleResult.setSuccessful(true);
} catch (e) {
    WDS.sampleResult.setSuccessful(false);
    throw e;
}
WDS.sampleResult.sampleEnd();
]]>
          </stringProp>
        </WebDriverSampler>
        <hashTree/>
        <ConstantTimer>
          <stringProp name="ConstantTimer.delay">1000</stringProp>
        </ConstantTimer>
        <hashTree/>
        <DurationAssertion>
          <stringProp name="DurationAssertion.duration">3000</stringProp>
        </DurationAssertion>
        <hashTree/>
        <ResponseAssertion>
          <collectionProp name="Asserion.test_strings">
            <stringProp name="0">Choose This Flight</stringProp>
          </collectionProp>
          <stringProp name="Assertion.custom-message"></stringProp>
          <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
          <boolProp name="Assertion.assume_success">false</boolProp>
          <intProp name="Assertion.test_type">2</intProp>
        </ResponseAssertion>
        <hashTree/>
        <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report" enabled="true">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <time>true</time>
              <latency>true</latency>
              <timestamp>true</timestamp>
              <success>true</success>
              <label>true</label>
              <code>true</code>
